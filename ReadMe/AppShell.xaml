<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReadMe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReadMe"
    xmlns:views="clr-namespace:ReadMe.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutWidth="250"
    Title="ReadMe"
    BackgroundColor="White">

    <!-- Contenu du Flyout (Burger Menu) -->

    <Shell.FlyoutContent>
        <Grid Padding="0" RowDefinitions="Auto,*,Auto" BackgroundColor="White" RowSpacing="0">
            <!-- En-tête du menu -->
            <StackLayout Grid.Row="0" Padding="20" BackgroundColor="#512BD4" Spacing="10">
                <Label Text="📚 ReadMe" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Label Text="Votre bibliothèque numérique" FontSize="12" TextColor="#E0E0E0" />
            </StackLayout>

            <!-- Éléments du menu -->
            <StackLayout Grid.Row="1" Padding="0" Spacing="0">
                <!-- Accueil -->
                <StackLayout Padding="15" Spacing="0" x:Name="AccueilMenuItem">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAccueilClicked" />
                    </StackLayout.GestureRecognizers>
                    <Label Text="🏠 Accueil" FontSize="16" TextColor="#333333" />
                    <Label Text="Voir votre bibliothèque" FontSize="12" TextColor="#999999" />
                </StackLayout>
                <BoxView Color="#E0E0E0" HeightRequest="1" Margin="15,0" />

                <!-- Mes livres -->
                <StackLayout Padding="15" Spacing="0" x:Name="BooksMenuItem">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBooksClicked" />
                    </StackLayout.GestureRecognizers>
                    <Label Text="📖 Mes livres" FontSize="16" TextColor="#333333" />
                    <Label Text="Gérer votre collection" FontSize="12" TextColor="#999999" />
                </StackLayout>
                <BoxView Color="#E0E0E0" HeightRequest="1" Margin="15,0" />

                <!-- Tags -->
                <StackLayout Padding="15" Spacing="0" x:Name="TagsMenuItem">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTagsClicked" />
                    </StackLayout.GestureRecognizers>
                    <Label Text="🏷️ Tags" FontSize="16" TextColor="#333333" />
                    <Label Text="Organiser vos catégories" FontSize="12" TextColor="#999999" />
                </StackLayout>
                <BoxView Color="#E0E0E0" HeightRequest="1" Margin="15,0" />

                <!-- Paramètres -->
                <StackLayout Padding="15" Spacing="0" x:Name="SettingsMenuItem">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsClicked" />
                    </StackLayout.GestureRecognizers>
                    <Label Text="⚙️ Paramètres" FontSize="16" TextColor="#333333" />
                    <Label Text="Configuration de l'app" FontSize="12" TextColor="#999999" />
                </StackLayout>
                <BoxView Color="#E0E0E0" HeightRequest="1" Margin="15,0" />
            </StackLayout>

            <!-- Pied de page -->
            <StackLayout Grid.Row="2" Padding="15" BackgroundColor="#F9F9F9" Spacing="5">
                <Label Text="v1.0.0" FontSize="11" TextColor="#999999" />
                <Label Text="© 2026 ReadMe" FontSize="11" TextColor="#999999" />
            </StackLayout>
        </Grid>
    </Shell.FlyoutContent>

    <!-- Navigation par onglets -->
    <TabBar>
        <ShellContent
            Title="Accueil"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Title="Tags"
            Icon="tag.png"
            ContentTemplate="{DataTemplate views:TagsPage}"
            Route="tags" />
    </TabBar>

    <!-- Routes pour la navigation -->
    <ShellContent
        Route="bookdetail"
        ContentTemplate="{DataTemplate views:BookDetailPage}" />

    <ShellContent
        Route="reader"
        ContentTemplate="{DataTemplate views:ReaderPage}" />

    <ShellContent
        Route="settings"
        ContentTemplate="{DataTemplate views:SettingsPage}" />

</Shell>
