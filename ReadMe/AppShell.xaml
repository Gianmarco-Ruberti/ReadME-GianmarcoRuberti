<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReadMe.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReadMe"
    xmlns:views="clr-namespace:ReadMe.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="ReadMe">

    <TabBar>
        <ShellContent
            Title="Accueil"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Title="Tags"
            Icon="tag.png"
            ContentTemplate="{DataTemplate views:TagsPage}"
            Route="tags" />
    </TabBar>

    <!-- Routes pour la navigation -->
    <ShellContent
        Route="bookdetail"
        ContentTemplate="{DataTemplate views:BookDetailPage}" />

    <ShellContent
        Route="reader"
        ContentTemplate="{DataTemplate views:ReaderPage}" />

</Shell>
