<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReadMe.Views.BookDetailPage">
    <ContentPage.Content>
        <StackLayout Padding="15" Spacing="15">
            
            <!-- Couverture et infos principales -->
            <StackLayout Spacing="10">
                <!-- Couverture -->
                <Frame CornerRadius="15" Padding="0" HasShadow="True" BackgroundColor="#F5F5F5" HeightRequest="250">
                    <Label Text="📖" FontSize="100" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                </Frame>

                <!-- Titre -->
                <Label Text="{Binding Book.Title}" FontSize="22" FontAttributes="Bold" TextColor="#512BD4" />

                <!-- Auteur -->
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Auteur :" FontSize="14" FontAttributes="Bold" />
                    <Label Text="{Binding Book.Author}" FontSize="14" TextColor="#666666" />
                </StackLayout>

                <!-- Date d'ajout -->
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Ajouté le :" FontSize="14" FontAttributes="Bold" />
                    <Label Text="{Binding Book.DateAdded, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" TextColor="#666666" />
                </StackLayout>
            </StackLayout>

            <!-- Séparateur -->
            <BoxView Color="#E0E0E0" HeightRequest="1" />

            <!-- Section Tags -->
            <StackLayout Spacing="10">
                <Label Text="Tags associés" FontSize="16" FontAttributes="Bold" TextColor="#512BD4" />
                
                <!-- Tags actuels -->
                <CollectionView ItemsSource="{Binding Book.Tags}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="20" Padding="12,6" BackgroundColor="#E3F2FD" HasShadow="False">
                                <StackLayout Orientation="Horizontal" Spacing="8">
                                    <Label Text="{Binding Name}" FontSize="12" TextColor="#1976D2" VerticalOptions="Center" />
                                    <Label Text="✕" FontSize="12" TextColor="#1976D2" VerticalOptions="Center" />
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Ajouter tags -->
                <Label Text="Ajouter des tags" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0" />
                <CollectionView ItemsSource="{Binding AvailableTags}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="20" Padding="12,6" BackgroundColor="White" HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAvailableTagTapped" />
                                </Frame.GestureRecognizers>
                                <Label Text="{Binding Name}" FontSize="12" TextColor="#666666" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Boutons d'action -->
            <StackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="💾 Enregistrer" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="10" Padding="15" Clicked="OnSaveClicked" />
                <Button Text="🗑️ Supprimer" BackgroundColor="#F44336" TextColor="White" CornerRadius="10" Padding="15" Clicked="OnDeleteClicked" />
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
