<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReadMe.Views.SettingsPage"
             Title="Paramètres">
    <ContentPage.Content>
        <StackLayout Padding="15" Spacing="15">
            <Label Text="⚙️ Paramètres" FontSize="24" FontAttributes="Bold" TextColor="#512BD4" />
            
            <!-- Section Apparence -->
            <Frame CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                <StackLayout Spacing="10">
                    <Label Text="Apparence" FontSize="16" FontAttributes="Bold" />
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="Thème sombre" FontSize="14" VerticalOptions="Center" HorizontalOptions="FillAndExpand" />
                        <Switch />
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Section Stockage -->
            <Frame CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                <StackLayout Spacing="10">
                    <Label Text="Stockage" FontSize="16" FontAttributes="Bold" />
                    <Label Text="Taille de la bibliothèque : 0 MB" FontSize="12" TextColor="#666666" />
                    <Button Text="🗑️ Vider le cache" 
                           BackgroundColor="#F44336" 
                           TextColor="White" 
                           CornerRadius="10" 
                           Padding="15" />
                </StackLayout>
            </Frame>

            <!-- Section À propos -->
            <Frame CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                <StackLayout Spacing="10">
                    <Label Text="À propos" FontSize="16" FontAttributes="Bold" />
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="Version" FontSize="14" HorizontalOptions="FillAndExpand" />
                        <Label Text="v1.0.0" FontSize="14" TextColor="#666666" />
                    </StackLayout>
                    <Button Text="📖 À propos de ReadMe" 
                           BackgroundColor="#2196F3" 
                           TextColor="White" 
                           CornerRadius="10" 
                           Padding="15" />
                </StackLayout>
            </Frame>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
