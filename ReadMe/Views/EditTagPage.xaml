<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ReadMe.Views.EditTagPage"
             Title="Éditer Tag">
    <ContentPage.Content>
        <StackLayout Padding="20" Spacing="15">
            
            <Label Text="Éditer un tag" FontSize="24" FontAttributes="Bold" TextColor="#512BD4" />
            
            <!-- Champ Nom -->
            <StackLayout Spacing="5">
                <Label Text="Nom du tag" FontSize="14" FontAttributes="Bold" />
                <Frame CornerRadius="5" Padding="0" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0">
                    <Entry Placeholder="Ex: Fiction" 
                          Text="{Binding CurrentTag.Name}" />
                </Frame>
            </StackLayout>

            <!-- Champ Couleur -->
            <StackLayout Spacing="5">
                <Label Text="Couleur (code hexadécimal)" FontSize="14" FontAttributes="Bold" />
                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Frame CornerRadius="5" Padding="0" HasShadow="False" BackgroundColor="White" BorderColor="#E0E0E0" HorizontalOptions="FillAndExpand">
                        <Entry Placeholder="#512BD4" 
                              Text="{Binding CurrentTag.Color}" />
                    </Frame>
                    <BoxView Color="{Binding CurrentTag.Color}" 
                            WidthRequest="50" 
                            HeightRequest="50" 
                            CornerRadius="5" />
                </StackLayout>
            </StackLayout>

            <!-- Palette de couleurs rapide -->
            <Label Text="Couleurs rapides" FontSize="14" FontAttributes="Bold" Margin="0,10,0,0" />
            <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="Start">
                <BoxView Color="#FFB300" WidthRequest="40" HeightRequest="40" CornerRadius="5">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorTapped" CommandParameter="#FFB300" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <BoxView Color="#1976D2" WidthRequest="40" HeightRequest="40" CornerRadius="5">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorTapped" CommandParameter="#1976D2" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <BoxView Color="#388E3C" WidthRequest="40" HeightRequest="40" CornerRadius="5">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorTapped" CommandParameter="#388E3C" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <BoxView Color="#D32F2F" WidthRequest="40" HeightRequest="40" CornerRadius="5">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorTapped" CommandParameter="#D32F2F" />
                    </BoxView.GestureRecognizers>
                </BoxView>
                <BoxView Color="#7B1FA2" WidthRequest="40" HeightRequest="40" CornerRadius="5">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnColorTapped" CommandParameter="#7B1FA2" />
                    </BoxView.GestureRecognizers>
                </BoxView>
            </StackLayout>

            <!-- Boutons d'action -->
            <StackLayout Spacing="10" Margin="0,30,0,0">
                <Button Text="💾 Enregistrer" 
                       BackgroundColor="#4CAF50" 
                       TextColor="White" 
                       CornerRadius="10" 
                       Padding="15"
                       Clicked="OnSaveClicked" />
                <Button Text="❌ Annuler" 
                       BackgroundColor="#9E9E9E" 
                       TextColor="White" 
                       CornerRadius="10" 
                       Padding="15"
                       Clicked="OnCancelClicked" />
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
